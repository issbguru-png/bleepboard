.cache/

# Pending submissions: real people's files and contact details, which have no
# business in a public repo. The README and the reviewed/ record stay.
data/submissions/*
!data/submissions/README.md
!data/submissions/reviewed/

# Wrangler local state and local-mode KV. Not ours to track, and it holds
# cached copies of whatever passed through the submission queue.
.wrangler/
**/.wrangler/
