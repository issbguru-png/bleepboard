---
import { getCollection } from "astro:content";
import '../styles/global.css';
import { SITE, canonical, absolute } from '../lib/site';
import Analytics from '../components/Analytics.astro';
import Woofer from '../components/Woofer.astro';

interface Props {
  title: string;
  description: string;
  /** JSON-LD objects to inject */
  schema?: object[];
  noindex?: boolean;
  ogType?: string;
  /** category slug — drives the accent hue for this page */
  cat?: string;
  /** Share card override. Site-relative or absolute; made absolute either way.
   *  Defaults to the sitewide card in public/og-image.png. */
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
}

const {
  title,
  description,
  schema = [],
  noindex = false,
  ogType = 'website',
  cat,
  ogImage,
  ogImageAlt,
  ogImageWidth,
  ogImageHeight,
} = Astro.props;
const canonicalUrl = canonical(Astro.url.pathname);

// Facebook, X, Slack, Discord and iMessage all refuse or mishandle a relative
// og:image, so this is absolutised regardless of what the caller passed.
const ogImageUrl = absolute(ogImage ?? SITE.ogImage);
const ogAlt = ogImageAlt ?? (ogImage ? title : SITE.ogImageAlt);
// Dimension hints let scrapers reserve the right box before the image lands,
// but only when we actually know the size: the sitewide card is a known
// 1200x630, and an override is trusted only if it declared its own. Guessing
// here renders worse than saying nothing.
const ogDims = ogImage
  ? ogImageWidth && ogImageHeight
    ? { w: ogImageWidth, h: ogImageHeight }
    : null
  : { w: ogImageWidth ?? SITE.ogImageWidth, h: ogImageHeight ?? SITE.ogImageHeight };
// --- language & hreflang ---------------------------------------------------
// The site is English; Spanish lives under /es/. hreflang is emitted only for
// pages that genuinely have a twin, and always as a complete reciprocal set,
// because Google throws the whole cluster away if the alternates do not point
// back at each other. A blanket "/es" + pathname rule would therefore break
// the one pair that does exist the moment it guessed a URL that 404s.
//
// Keyed English path -> Spanish path. Add a row when a page is actually
// translated, not before.
const TRANSLATED: Record<string, string> = {
  '/': '/es/',
};
// Themed hubs register their own pair the moment they carry `es` content, so
// a new bilingual theme needs no edit here.
for (const t of await getCollection('themes')) {
  if (t.data.es) TRANSLATED[`/${t.id}-soundboard/`] = `/es/${t.id}-soundboard/`;
}
const here = Astro.url.pathname;
const path = here.endsWith('/') ? here : here + '/';
const isEs = path === '/es/' || path.startsWith('/es/');
const enPath = isEs
  ? Object.keys(TRANSLATED).find((k) => TRANSLATED[k] === path)
  : TRANSLATED[path]
    ? path
    : undefined;
const esPath = enPath ? TRANSLATED[enPath] : undefined;
const lang = isEs ? 'es' : 'en';
const alternates: [string, string][] =
  enPath && esPath
    ? [
        ['en', SITE.url + enPath],
        ['es', SITE.url + esPath],
        // x-default is the page for a searcher whose language we have no
        // better answer for, which is the English original.
        ['x-default', SITE.url + enPath],
      ]
    : [];
const ogLocale = isEs ? 'es_ES' : 'en_US';
const ogLocaleAlt = alternates.length ? (isEs ? 'en_US' : 'es_ES') : undefined;

const nav = [
  ['/new/', 'New'],
  ['/trending/', 'Trending'],
  ['/categories/', 'Categories'],
  ['/blog/', 'Blog'],
];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Consent Mode v2 defaults must run before any other Google script */}
    <Analytics />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {alternates.map(([hl, href]) => (
      <link rel="alternate" hreflang={hl} href={href} />
    ))}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocale} />
    {ogLocaleAlt && <meta property="og:locale:alternate" content={ogLocaleAlt} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogAlt} />
    {ogDims && (
      <>
        <meta property="og:image:width" content={String(ogDims.w)} />
        <meta property="og:image:height" content={String(ogDims.h)} />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.twitter} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <meta name="theme-color" content="#faf8f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131211" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {schema.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}
  </head>
  <body data-cat={cat}>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="logo" href="/">
          <span class="logo-mark" aria-hidden="true">
            <Woofer variant="mark" size={28} />
          </span>
          Bleepboard
        </a>
        <nav class="site-nav" aria-label="Main" lang={isEs ? 'en' : undefined}>
          {nav.map(([href, label]) => (
            <a href={href} aria-current={here === href ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <span class="foot-brand">© {new Date().getFullYear()} {SITE.name}</span>
        <nav class="footer-nav" aria-label="Footer" lang={isEs ? 'en' : undefined}>
          <ul class="footer-links">
            <li><a href="/categories/">Categories</a></li>
            <li><a href="/blog/">Blog</a></li>
            <li><a href="/about/">About</a></li>
            <li><a href="/dmca/">DMCA</a></li>
            <li><a href="/privacy/">Privacy</a></li>
            {/* CPRA wants this control reachable from every page, and it goes to
                the section that explains what it does rather than to a button
                that pretends to have done it. */}
            <li class="foot-wide">
              <a href="/privacy/#do-not-sell">Do Not Sell or Share My Personal Information</a>
            </li>
          </ul>
        </nav>
        {/* Language switch. hreflang tells Google the two pages are a pair; it
            does nothing for a Spanish speaker who has already landed on the
            English page. `lang` on the link so a screen reader pronounces the
            target language's own name correctly. */}
        <nav class="footer-lang" aria-label={isEs ? 'Idioma' : 'Language'}>
          {/* Prefer this page's own counterpart; fall back to the landing
              page when no translation exists. Nobody should switch language
              and lose their place if we have the page. */}
          {isEs
            ? <a href={enPath ?? '/'} lang="en" hreflang="en">English</a>
            : <a href={esPath ?? '/es/'} lang="es" hreflang="es">Español</a>}
        </nav>
      </div>
    </footer>
    <script src="../scripts/player.ts"></script>
  </body>
</html>

<style>
  /* --- footer layout -------------------------------------------------------
     Scoped to this layout on purpose; global.css is owned elsewhere right now.

     Desktop (>=560px) is deliberately byte-for-byte the same picture as before:
     one flex row, brand hard left (margin-right:auto from global.css still
     does the pushing), links as a right-aligned row with a 24px column gap.
     The <ul> is reset flat so it contributes no box of its own.

     Below 560px that single row cannot fit — ~285px of text plus 4x24px of
     column gap is ~381px, against 288px of usable width at 320px (and 343px at
     375px), so it used to wrap. Because .foot-brand carries margin-right:auto, the auto
     margin resolved on the *first* line only: line one was stretched to the
     full width (brand pinned left, "Categories Blog" shoved against the right
     edge) while the remainder ("About DMCA" at 320px, a lone "DMCA" at 375px)
     sat orphaned at the left of line two. Row gap (12px) and column gap (24px)
     also disagreed, so the two lines never read as a pair. And the links were
     bare inline text: ~16px of hit height, far under the 44px target.

     So below 560px we stop wrapping and lay out deliberately: an even 2x2 grid
     of tap-sized pills (same pill vocabulary as the mobile .site-nav rail),
     with the copyright on its own centred row underneath.
  ------------------------------------------------------------------------- */
  .site-footer .wrap.footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s3) var(--s5);
  }

  .site-footer .footer-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s3) var(--s5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* The CPRA opt-out link has a long label by law rather than by choice, so on
     mid-width screens the row can no longer hold every link. Wrapped lines are
     pushed to the right edge, under the rest of the nav, so a wrap reads as a
     second line of the same block instead of a stray orphan on the left. */
  @media (min-width: 560px) {
    .site-footer .footer-links { justify-content: flex-end; }
  }

  @media (max-width: 559.98px) {
    .site-footer .wrap.footer-inner {
      flex-direction: column;
      align-items: stretch;
      gap: var(--s5);
    }
    /* links first, copyright as its own closing row */
    .site-footer .wrap.footer-inner .footer-nav { order: 1; }
    .site-footer .wrap.footer-inner .foot-brand {
      order: 2;
      margin-right: 0;   /* beats the desktop `margin-right: auto` */
      text-align: center;
    }

    .site-footer .footer-links {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--s2);    /* one consistent value for rows and columns */
    }

    /* An odd link count would leave the last pill orphaned in the left column
       with a hole beside it. Let it span the full width instead, so the block
       always closes on a straight edge.

       :nth-child(odd):last-child is self-correcting rather than a hardcoded
       "5th item" rule — it fires only when the count is actually odd. With the
       six links currently in the footer it stays dormant. */
    .site-footer .footer-links li:nth-child(odd):last-child {
      grid-column: 1 / -1;
    }

    /* "Do Not Sell or Share My Personal Information" is four lines of text in a
       140px column at 320px, so it takes a row of its own. */
    .site-footer .footer-links li.foot-wide { grid-column: 1 / -1; }

    /* Which leaves the five links ahead of it resolving to 2 + 2 + 1, with the
       fifth alone beside a hole. Span that one too. Same self-correcting shape
       as the rule above: it fires only while the count before the wide pill is
       odd, so a seventh link restores the plain grid on its own. Browsers
       without :has() land back on the orphan, which is cosmetic. */
    .site-footer .footer-links li:nth-child(odd):has(+ li.foot-wide) {
      grid-column: 1 / -1;
    }

    .site-footer .footer-links a {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;  /* border-box, so this is the real tap height */
      padding: var(--s2) var(--s3);
      text-align: center;
      border: 1px solid var(--line);
      border-radius: var(--r-pill);
      background: var(--surface);
      color: var(--ink-2);
    }
    .site-footer .footer-links a:hover,
    .site-footer .footer-links a:focus-visible {
      color: var(--accent-text);
      border-color: var(--line-2);
    }
    /* keep the global focus ring, just let it hug the pill */
    .site-footer .footer-links a:focus-visible {
      outline: 3px solid var(--focus);
      outline-offset: 2px;
    }
  }

  @media (max-width: 559.98px) and (prefers-reduced-motion: no-preference) {
    .site-footer .footer-links a {
      transition: color 0.14s, background 0.14s, border-color 0.14s;
    }
  }
</style>
