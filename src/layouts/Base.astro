---
import '../styles/global.css';
import { SITE, canonical } from '../lib/site';
import Woofer from '../components/Woofer.astro';

interface Props {
  title: string;
  description: string;
  /** JSON-LD objects to inject */
  schema?: object[];
  noindex?: boolean;
  ogType?: string;
  /** category slug — drives the accent hue for this page */
  cat?: string;
}

const { title, description, schema = [], noindex = false, ogType = 'website', cat } = Astro.props;
const canonicalUrl = canonical(Astro.url.pathname);
const nav = [
  ['/new/', 'New'],
  ['/trending/', 'Trending'],
  ['/categories/', 'Categories'],
  ['/blog/', 'Blog'],
];
const here = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#faf8f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131211" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {schema.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}
  </head>
  <body data-cat={cat}>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="logo" href="/">
          <span class="logo-mark" aria-hidden="true">
            <Woofer variant="mark" size={28} />
          </span>
          Bleepboard
        </a>
        <nav class="site-nav" aria-label="Main">
          {nav.map(([href, label]) => (
            <a href={href} aria-current={here === href ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <span class="foot-brand">© {new Date().getFullYear()} {SITE.name}</span>
        <nav class="footer-nav" aria-label="Footer">
          <ul class="footer-links">
            <li><a href="/categories/">Categories</a></li>
            <li><a href="/blog/">Blog</a></li>
            <li><a href="/about/">About</a></li>
            <li><a href="/dmca/">DMCA</a></li>
            <li><a href="/privacy/">Privacy</a></li>
          </ul>
        </nav>
      </div>
    </footer>
    <script src="../scripts/player.ts"></script>
  </body>
</html>

<style>
  /* --- footer layout -------------------------------------------------------
     Scoped to this layout on purpose; global.css is owned elsewhere right now.

     Desktop (>=560px) is deliberately byte-for-byte the same picture as before:
     one flex row, brand hard left (margin-right:auto from global.css still
     does the pushing), links as a right-aligned row with a 24px column gap.
     The <ul> is reset flat so it contributes no box of its own.

     Below 560px that single row cannot fit — ~285px of text plus 4x24px of
     column gap is ~381px, against 288px of usable width at 320px (and 343px at
     375px), so it used to wrap. Because .foot-brand carries margin-right:auto, the auto
     margin resolved on the *first* line only: line one was stretched to the
     full width (brand pinned left, "Categories Blog" shoved against the right
     edge) while the remainder ("About DMCA" at 320px, a lone "DMCA" at 375px)
     sat orphaned at the left of line two. Row gap (12px) and column gap (24px)
     also disagreed, so the two lines never read as a pair. And the links were
     bare inline text: ~16px of hit height, far under the 44px target.

     So below 560px we stop wrapping and lay out deliberately: an even 2x2 grid
     of tap-sized pills (same pill vocabulary as the mobile .site-nav rail),
     with the copyright on its own centred row underneath.
  ------------------------------------------------------------------------- */
  .site-footer .wrap.footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s3) var(--s5);
  }

  .site-footer .footer-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s3) var(--s5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (max-width: 559.98px) {
    .site-footer .wrap.footer-inner {
      flex-direction: column;
      align-items: stretch;
      gap: var(--s5);
    }
    /* links first, copyright as its own closing row */
    .site-footer .wrap.footer-inner .footer-nav { order: 1; }
    .site-footer .wrap.footer-inner .foot-brand {
      order: 2;
      margin-right: 0;   /* beats the desktop `margin-right: auto` */
      text-align: center;
    }

    .site-footer .footer-links {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--s2);    /* one consistent value for rows and columns */
    }

    /* Odd link count (5, since Privacy joined) would leave the last pill
       orphaned in the left column with a hole beside it. Let it span the full
       width instead, so the block always closes on a straight edge.

       :nth-child(odd):last-child is self-correcting rather than a hardcoded
       "5th item" rule — it fires only when the count is actually odd, so
       adding a sixth link silently restores the plain 3x2 grid. */
    .site-footer .footer-links li:nth-child(odd):last-child {
      grid-column: 1 / -1;
    }

    .site-footer .footer-links a {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;  /* border-box, so this is the real tap height */
      padding: var(--s2) var(--s3);
      text-align: center;
      border: 1px solid var(--line);
      border-radius: var(--r-pill);
      background: var(--surface);
      color: var(--ink-2);
    }
    .site-footer .footer-links a:hover,
    .site-footer .footer-links a:focus-visible {
      color: var(--accent-text);
      border-color: var(--line-2);
    }
    /* keep the global focus ring, just let it hug the pill */
    .site-footer .footer-links a:focus-visible {
      outline: 3px solid var(--focus);
      outline-offset: 2px;
    }
  }

  @media (max-width: 559.98px) and (prefers-reduced-motion: no-preference) {
    .site-footer .footer-links a {
      transition: color 0.14s, background 0.14s, border-color 0.14s;
    }
  }
</style>
