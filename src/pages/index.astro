---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SoundButton from '../components/SoundButton.astro';
import Woofer from '../components/Woofer.astro';
import { SITE, hubPath } from '../lib/site';

const sounds = await getCollection('sounds');
const categories = (await getCollection('categories')).sort(
  (a, b) => a.data.order - b.data.order
);
const counts = new Map<string, number>();
for (const s of sounds) counts.set(s.data.category, (counts.get(s.data.category) ?? 0) + 1);

const trending = [...sounds]
  .sort((a, b) => b.data.plays - a.data.plays)
  .slice(0, 18);
const newest = [...sounds]
  .sort((a, b) => b.data.added.valueOf() - a.data.added.valueOf())
  .slice(0, 14);

const total = sounds.length;
const quick = ['airhorn', 'vine boom', 'discord', 'fart', 'brainrot', 'notification'];
const title = 'Bleepboard — Instant Sound Buttons & Meme Soundboard';
const description = SITE.description;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
  },
];
---
<Base title={title} description={description} schema={schema}>
  <section class="hero">
    <a class="hero-mascot" href="#woofer" aria-label="Meet Woofer, the Bleepboard mascot">
      <Woofer size={200} class="hero-woofer" />
    </a>

    <div class="hero-copy">
    <p class="eyebrow"><span class="tick"></span>Free meme soundboard</p>
    <h1>Instant sound buttons for every meme</h1>
    <p class="lede">
      Tap a button, hear the sound. Bleepboard is a free meme soundboard —
      play and download meme sounds, viral clips, and sound effects instantly.
      No signup. No install.
    </p>

    <div class="searchbox">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/></svg>
      <input
        id="q"
        type="search"
        placeholder={`Search ${total} sounds…`}
        aria-label="Search sounds by name or tag"
        aria-controls="results"
        autocomplete="off"
        autocorrect="off"
        spellcheck="false"
      />
    </div>

    <ul class="search-tools">
      <li class="label" aria-hidden="true">Try</li>
      {quick.map((term) => (
        <li><button class="chip" type="button" data-term={term}>{term}</button></li>
      ))}
    </ul>

    <ul class="stats stats--icon">
      <li>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/><path d="M18.5 5.5a9 9 0 0 1 0 13"/></svg>
        <span><b class="tnum">{total}</b> sound buttons</span>
      </li>
      <li>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"/><path d="m7.5 10.5 4.5 4.5 4.5-4.5"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>
        <span><b>Free</b> MP3 downloads</span>
      </li>
      <li>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3 1.9 5.6L19.5 10l-5.6 1.9L12 17.5l-1.9-5.6L4.5 10l5.6-1.4z"/><path d="M18 16.5l.7 2.1 2.1.7-2.1.7-.7 2.1-.7-2.1-2.1-.7 2.1-.7z"/></svg>
        <span><b>New</b> sounds added regularly</span>
      </li>
    </ul>
    </div>
  </section>

  <section class="section" id="results-section" hidden>
    <div class="section-head">
      <h2 id="results-heading">Search results</h2>
      <button class="section-link" type="button" id="clear-search">Clear search ✕</button>
    </div>
    <p id="count" class="result-count" role="status" aria-live="polite"></p>
    <div id="results" class="grid grid--lg" aria-labelledby="results-heading"></div>
    <p id="empty" class="empty-state" hidden>
      No sounds match that. Try a shorter word, or browse <a href="/categories/">every soundboard</a>.
    </p>
  </section>

  <div id="browse">

  <section class="section">
    <div class="section-head">
      <h2>Trending sounds</h2>
      <a class="section-link" href="/trending/">All trending →</a>
    </div>
    <p class="section-sub">Ranked by plays — what the internet is pressing right now.</p>
    <div class="grid grid--lg">
      {trending.map((s, i) => (
        <SoundButton slug={s.id} title={s.data.title} audio={s.data.audio} duration={s.data.duration} category={s.data.category} rank={i < 3 ? i + 1 : undefined} />
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Latest additions</h2>
      <a class="section-link" href="/new/">All new sounds →</a>
    </div>
    <p class="section-sub">The most recent clips to join the board.</p>
    <div class="grid">
      {newest.map((s) => (
        <SoundButton slug={s.id} title={s.data.title} audio={s.data.audio} duration={s.data.duration} category={s.data.category} isNew />
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Browse by category</h2>
      <a class="section-link" href="/categories/">All categories →</a>
    </div>
    <p class="section-sub">{categories.length} soundboards, each with its own corner of the internet.</p>
    <div class="cat-grid">
      {categories.map((c) => (
        <a class="cat-card" href={hubPath(c.id)} data-cat={c.id}>
          <span class="cat-name">{c.data.name}</span>
          <span class="cat-count tnum">{counts.get(c.id) ?? 0} sounds</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section prose">
    <h2>What is Bleepboard?</h2>
    <p>
      Bleepboard is a soundboard built for speed: every sound button plays the moment
      you tap it, and every sound has its own page with a free MP3 download, the story
      behind the clip, and an embed code so you can drop the button into your own site,
      stream overlay, or Discord server.
    </p>
    <p>
      We add new sound buttons regularly — aiming to cut them within a day or two of a meme
      taking off on TikTok or YouTube. Check the <a href="/new/">newest sounds</a> or
      browse by category above.
    </p>
  </section>

  <section class="section" id="woofer">
    <div class="section-head">
      <h2>Who runs this place</h2>
    </div>
    <div class="author-card">
      <Woofer size={128} />
      <div class="author-body">
        <h3>Woofer</h3>
        <p class="author-role">Bleepboard's resident sound gremlin</p>
        <p>
          Woofer is a speaker cabinet that grew legs and developed opinions. He lives
          somewhere in the server rack, wears headphones he refuses to take off, and
          spends his days doing the one thing he's good at: hearing a clip go viral and
          immediately needing it catalogued.
        </p>
        <p>
          His filing system is aggressive. A sound doesn't get a button here until Woofer
          knows where it came from — which film, which stream, which unhinged six seconds
          of someone's Tuesday. That's why every sound on this site has a write-up
          instead of a shrug. He finds untagged audio genuinely upsetting.
        </p>
        <p>
          His big driver twitches when something is about to trend. He is usually right,
          and unbearable about it.
        </p>
        <p class="author-note">
          Woofer is our mascot, not a real person — Bleepboard is made by a small team who
          find a cartoon speaker easier to draw than themselves. Say hello on the
          <a href="/about/">about page</a>.
        </p>
      </div>
    </div>
  </section>
  </div>

  <script>
    type Item = {
      slug: string; title: string; tags: string[];
      category: string; audio: string; duration: number;
    };

    const q = document.getElementById('q') as HTMLInputElement;
    const browse = document.getElementById('browse')!;
    const section = document.getElementById('results-section')!;
    const results = document.getElementById('results')!;
    const empty = document.getElementById('empty')!;
    const count = document.getElementById('count')!;
    const clear = document.getElementById('clear-search')!;
    let index: Item[] = [];
    let loaded = false;

    const esc = (s: string) =>
      s.replace(/[&<>"']/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!
      );
    const dur = (n: number) => `${n.toFixed(1).replace(/\.0$/, '')}s`;

    const PLAY = '<svg class="i-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8.4 5.2a1 1 0 0 1 1.52-.85l9.1 5.5a1.4 1.4 0 0 1 0 2.4l-9.1 5.5a1 1 0 0 1-1.52-.85z"/></svg>';

    function card(s: Item) {
      const title = esc(s.title);
      return `<article class="bleep" data-cat="${esc(s.category)}" style="--dur:${s.duration}s">
        <button class="bleep-play" type="button" data-src="${esc(s.audio)}" data-slug="${esc(s.slug)}" aria-label="Play ${title}" aria-pressed="false">
          <span class="bleep-ico" aria-hidden="true">${PLAY}<span class="i-eq"><i></i><i></i><i></i></span></span>
          <span class="bleep-dur" aria-hidden="true">${dur(s.duration)}</span>
          <span class="bleep-bar" aria-hidden="true"></span>
        </button>
        <a class="bleep-title" href="/sound/${esc(s.slug)}/"><span>${title}</span></a>
      </article>`;
    }

    /** The index is only needed once someone actually searches, so it never
     *  costs a first-paint request on the homepage. */
    async function ensureIndex() {
      if (loaded) return;
      try {
        index = await (await fetch('/search-index.json')).json();
        loaded = true;
      } catch {
        count.textContent = 'Search is unavailable right now — try browsing by category below.';
      }
    }

    function showBrowse() {
      section.hidden = true;
      browse.hidden = false;
      results.innerHTML = '';
    }

    async function search() {
      const query = q.value.trim();
      if (!query) return showBrowse();

      await ensureIndex();
      const terms = query.toLowerCase().split(/\s+/).filter(Boolean);
      const hits = index.filter((s) => {
        const hay = (s.title + ' ' + s.tags.join(' ') + ' ' + s.category).toLowerCase();
        return terms.every((t) => hay.includes(t));
      });

      browse.hidden = true;
      section.hidden = false;
      results.innerHTML = hits.map(card).join('');
      empty.hidden = hits.length > 0;
      count.textContent = hits.length
        ? `${hits.length} ${hits.length === 1 ? 'sound' : 'sounds'} matching “${query}”`
        : `Nothing matching “${query}”`;
    }

    q.addEventListener('input', search);
    q.addEventListener('focus', ensureIndex, { once: true });

    clear.addEventListener('click', () => {
      q.value = '';
      showBrowse();
      q.focus();
    });

    document.querySelectorAll<HTMLButtonElement>('.search-tools .chip').forEach((btn) => {
      btn.addEventListener('click', () => {
        q.value = btn.dataset.term ?? '';
        search();
        q.focus();
      });
    });

    // Escape clears the search and returns to browsing
    q.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && q.value) {
        e.preventDefault();
        q.value = '';
        showBrowse();
      }
    });
  </script>
</Base>
