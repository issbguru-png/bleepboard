---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SoundButton from '../components/SoundButton.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import StatIcon from '../components/StatIcon.astro';
import { SITE, hubPath, soundPath, pickTitle } from '../lib/site';
import { breadcrumbs, itemList, faqPage } from '../lib/schema';
import { themeSounds } from '../lib/themes';

export async function getStaticPaths() {
  const categories = await getCollection('categories');
  const themes = await getCollection('themes');
  // Both render at /{slug}-soundboard/. A theme slug that collides with a
  // category id would silently produce a duplicate route, so fail loudly.
  const catIds = new Set(categories.map((c) => c.id));
  for (const t of themes) {
    if (catIds.has(t.id)) {
      throw new Error(`Theme "${t.id}" collides with the category of the same name.`);
    }
  }
  return [
    ...categories.map((c) => ({ params: { hub: `${c.id}-soundboard` }, props: { entry: c, kind: 'category' as const } })),
    ...themes.map((t) => ({ params: { hub: `${t.id}-soundboard` }, props: { entry: t, kind: 'theme' as const } })),
  ];
}

const { entry, kind } = Astro.props;
const category = entry;
const d = entry.data as any;
const allSounds = await getCollection('sounds');
const sounds =
  kind === 'theme'
    ? themeSounds(allSounds, d.match)
    : allSounds
        .filter((s) => s.data.category === entry.id)
        .sort((a, b) => b.data.plays - a.data.plays);

// intro copy: first paragraph carries the page as the lede, the rest becomes
// the "about" block under the buttons — same words, better reading order.
const paras = d.intro.split('\n\n').map((p) => p.trim()).filter(Boolean);
const [lede, ...rest] = paras;

// sibling hubs, for internal linking out of the page
const others = (await getCollection('categories'))
  .filter((c) => c.id !== entry.id)
  .sort((a, b) => a.data.order - b.data.order);
const counts = new Map<string, number>();
for (const s of allSounds) counts.set(s.data.category, (counts.get(s.data.category) ?? 0) + 1);

// A theme has no CategoryIcon of its own, so it borrows one and inherits that
// category's hue for the page chrome. Keeps themes on-brand with no new assets.
const iconKey = kind === 'theme' ? (d.icon ?? 'meme') : entry.id;

const pageUrl = SITE.url + hubPath(entry.id);
// The old template repeated the category name and then bolted the brand on
// ("Notification Sounds Soundboard — Free Notification Sound Buttons |
// Bleepboard", 77 chars). Both competitors instead lead with the board name
// and hang a real count off it ("Spongebob Soundboard 1000+ Unique Sounds").
// `sounds.length` is the actual number rendered below, so the count is real.
const title = pickTitle([
  `${d.hubTitle} — ${sounds.length} Free Sound Buttons`,
  `${d.hubTitle} — ${sounds.length} Sound Buttons`,
  `${d.hubTitle} — Free Sound Buttons`,
  d.hubTitle,
]);

const schema: object[] = [
  breadcrumbs([
    ['Home', SITE.url + '/'],
    ['Categories', SITE.url + '/categories/'],
    [d.hubTitle, pageUrl],
  ]),
];
// The list mirrors exactly what the grid renders, in the same order.
if (sounds.length > 0) {
  schema.push(
    itemList(
      d.hubTitle,
      sounds.map((s) => ({ name: s.data.title, url: SITE.url + soundPath(s.id) })),
      d.metaDescription
    )
  );
}
if (d.faq.length > 0) schema.push(faqPage(d.faq));
---
<Base title={title} description={d.metaDescription} schema={schema} cat={iconKey}>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span class="sep" aria-hidden="true">›</span>
    <a href="/categories/">Categories</a>
    <span class="sep" aria-hidden="true">›</span>
    <span class="here">{d.hubTitle}</span>
  </nav>

  <section class="hub-hero">
    <div class="hero-mark">
      <CategoryIcon cat={iconKey} size={48} />
      <p class="eyebrow"><span class="tick"></span>Soundboard</p>
    </div>
    <h1>{d.hubTitle}</h1>
    <p class="lede">{lede}</p>
    <ul class="stats stats--icon">
      <li><StatIcon name="buttons" /><span><b class="tnum">{sounds.length}</b> sound buttons</span></li>
      <li><StatIcon name="download" /><span><b>Free</b> MP3 downloads</span></li>
      <li><StatIcon name="instant" /><span><b>Instant</b> — no signup</span></li>
    </ul>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>{d.name} sound buttons</h2>
      <a class="section-link" href="/categories/">All soundboards →</a>
    </div>
    <p class="section-sub">
      {sounds.length > 0
        ? `All ${sounds.length} clips in this board, most-played first. Tap to play, open a sound for the free MP3.`
        : 'This board is being filled in right now.'}
    </p>
    {sounds.length > 0 ? (
      <div class="grid grid--lg">
        {sounds.map((s, i) => (
          <SoundButton
            slug={s.id}
            title={s.data.title}
            audio={s.data.audio}
            duration={s.data.duration}
            category={s.data.category}
            rank={i < 3 ? i + 1 : undefined}
          />
        ))}
      </div>
    ) : (
      <p class="empty-state">
        Sounds coming soon — check the <a href="/new/">newest sounds</a> in the meantime.
      </p>
    )}
  </section>

  {rest.length > 0 && (
    <section class="section hub-about">
      <div class="section-head"><h2>About the {d.name.toLowerCase()} soundboard</h2></div>
      <div class="prose">
        {rest.map((para) => <p>{para}</p>)}
      </div>
    </section>
  )}

  {d.faq.length > 0 && (
    <section class="section faq">
      <div class="section-head"><h2>{d.name} soundboard FAQ</h2></div>
      <p class="section-sub">The questions people ask most about these sounds.</p>
      {d.faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>
  )}

  <section class="section">
    <div class="section-head">
      <h2>More soundboards</h2>
      <a class="section-link" href="/categories/">Browse all →</a>
    </div>
    <p class="section-sub">Every board is free, instant, and downloadable.</p>
    <div class="cat-grid">
      {others.map((c) => (
        <a class="cat-card" href={hubPath(c.id)} data-cat={c.id}>
          <CategoryIcon cat={c.id} />
          <span class="cat-name">{c.data.name}</span>
          <span class="cat-count tnum">{counts.get(c.id) ?? 0} sounds</span>
        </a>
      ))}
    </div>
  </section>
</Base>
