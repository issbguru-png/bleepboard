---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<Base
  title="Blog — Meme Sound Explainers & Guides | Bleepboard"
  description="Where meme sounds come from, how to use soundboards on Discord and OBS, and the stories behind the internet's favorite audio clips."
>
  <h1>Blog</h1>
  <p class="muted">The stories behind the sounds — meme origins, soundboard guides, trend breakdowns.</p>
  {posts.map((p) => (
    <article class="card">
      <h3 style="margin:0 0 4px"><a href={`/blog/${p.id}/`} style="text-decoration:none">{p.data.title}</a></h3>
      <p class="small" style="margin:0 0 8px">{p.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
      <p class="muted" style="margin:0">{p.data.description}</p>
    </article>
  ))}
</Base>
