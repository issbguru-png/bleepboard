---
/**
 * The embeddable player.
 *
 * This route exists for one reason: to be iframed on other people's sites and
 * send a link back. `public/_headers` deliberately sets no X-Frame-Options or
 * frame-ancestors so it stays framable.
 *
 * Worth being clear about what actually earns the link, because it changes how
 * this page is built. Google does not credit the host page with links that
 * live *inside* an iframe — those are links on a bleepboard.com document that
 * happens to be displayed elsewhere. The crawlable backlink is the plain <a>
 * that sits next to the iframe in the snippet we hand people (see
 * src/components/EmbedPanel.astro).
 *
 * So the links in here do a different job: they carry referral traffic and
 * they make the widget look credited rather than anonymous, which is what
 * stops someone stripping the credit line out of the snippet. The title goes
 * to the sound page; the wordmark goes to the homepage, because that is where
 * a curious first-time visitor should land.
 *
 * The document itself lives in EmbedPlayer.astro, shared with the Spanish
 * route. It ships alone onto someone else's page with no external stylesheet,
 * so the two languages cannot be allowed to drift apart.
 */
import { getCollection } from 'astro:content';
import EmbedPlayer from '../../components/EmbedPlayer.astro';
import { SITE, soundPath } from '../../lib/site';

export async function getStaticPaths() {
  const sounds = await getCollection('sounds');
  return sounds.map((s) => ({ params: { slug: s.id }, props: { sound: s } }));
}

const { sound } = Astro.props;
const d = sound.data;
---
<EmbedPlayer
  title={d.title}
  href={SITE.url + soundPath(sound.id)}
  audio={d.audio}
  duration={d.duration}
/>
