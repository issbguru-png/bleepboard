---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { hubPath } from '../lib/site';

const categories = (await getCollection('categories')).sort(
  (a, b) => a.data.order - b.data.order
);
const sounds = await getCollection('sounds');
const counts = new Map<string, number>();
for (const s of sounds) counts.set(s.data.category, (counts.get(s.data.category) ?? 0) + 1);
---
<Base
  title="All Soundboards by Category | Bleepboard"
  description="Browse every Bleepboard soundboard — meme sounds, sound effects, gaming, TikTok, anime, notifications, pranks and more."
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span class="sep" aria-hidden="true">›</span>
    <span class="here">Categories</span>
  </nav>

  <section class="page-head">
    <p class="eyebrow"><span class="tick"></span>{categories.length} soundboards</p>
    <h1>Soundboard categories</h1>
    <p class="lede">
      Every board on Bleepboard, each with its own corner of the internet —
      from brainrot and TikTok audio to clean, usable sound effects.
    </p>
    <ul class="stats">
      <li><b class="tnum">{sounds.length}</b> sound buttons total</li>
      <li><b class="tnum">{categories.length}</b> categories</li>
      <li><b>Free</b> MP3 downloads</li>
    </ul>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Browse every soundboard</h2>
      <a class="section-link" href="/search/">Or search all sounds →</a>
    </div>
    <p class="section-sub">Tap a board to open it — every sound plays instantly, no signup.</p>
    <div class="cat-grid cat-grid--lg">
      {categories.map((c) => (
        <a class="cat-card cat-card--lg" href={hubPath(c.id)} data-cat={c.id}>
          <span class="cat-name">{c.data.hubTitle}</span>
          <span class="cat-card-desc">{c.data.metaDescription}</span>
          <span class="cat-count tnum">{counts.get(c.id) ?? 0} sounds</span>
        </a>
      ))}
    </div>
  </section>
</Base>
