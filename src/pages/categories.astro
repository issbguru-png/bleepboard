---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { hubPath } from '../lib/site';

const categories = (await getCollection('categories')).sort(
  (a, b) => a.data.order - b.data.order
);
const sounds = await getCollection('sounds');
const counts = new Map<string, number>();
for (const s of sounds) counts.set(s.data.category, (counts.get(s.data.category) ?? 0) + 1);
---
<Base
  title="All Soundboards by Category | Bleepboard"
  description="Browse every Bleepboard soundboard — meme sounds, sound effects, gaming, TikTok, anime, notifications, pranks and more."
>
  <h1>Soundboard categories</h1>
  <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(220px,1fr))">
    {categories.map((c) => (
      <a class="bleep" href={hubPath(c.id)} style="text-decoration:none">
        <span class="bleep-title" style="font-size:16px">{c.data.hubTitle}</span>
        <span class="bleep-meta">{counts.get(c.id) ?? 0} sounds</span>
      </a>
    ))}
  </div>
</Base>
