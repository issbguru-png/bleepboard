---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SoundButton from '../components/SoundButton.astro';
import StatIcon from '../components/StatIcon.astro';
import { SITE, soundPath } from '../lib/site';
import { breadcrumbs, itemList } from '../lib/schema';

const sounds = (await getCollection('sounds')).sort(
  (a, b) => b.data.added.valueOf() - a.data.added.valueOf()
);
const fresh = sounds.slice(0, 18);
const rest = sounds.slice(18);
const latest = sounds[0]?.data.added;
const latestLabel = latest
  ? latest.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : '';

const schema = [
  breadcrumbs([
    ['Home', SITE.url + '/'],
    ['New', SITE.url + '/new/'],
  ]),
  itemList(
    'Newest sound buttons',
    sounds.map((s) => ({ name: s.data.title, url: SITE.url + soundPath(s.id) })),
    'Every sound button on Bleepboard, newest first.'
  ),
];
---
<Base
  title={`New Sound Buttons — ${sounds.length} Latest Meme Sounds`}
  description="The newest sound buttons on Bleepboard. Fresh meme sounds and viral audio clips, newest first. Tap to play, download the MP3 free."
  schema={schema}
>
  <section class="page-head">
    <div class="hero-mark">
      <StatIcon name="new" size={48} />
      <p class="eyebrow"><span class="tick"></span>Freshest first</p>
    </div>
    <h1>New sounds</h1>
    <p class="lede">
      The latest sound buttons on the board, newest first. When a meme breaks, this
      is where it lands first.
    </p>
    <ul class="stats stats--icon">
      <li><StatIcon name="buttons" /><span><b class="tnum">{sounds.length}</b> sounds on the board</span></li>
      {latestLabel && <li><StatIcon name="updated" /><span>Last update <b>{latestLabel}</b></span></li>}
      <li><StatIcon name="new" /><span><b>Newest</b> first</span></li>
    </ul>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Just added</h2>
      <a class="section-link" href="/trending/">What's trending →</a>
    </div>
    <p class="section-sub">The most recent {fresh.length} clips to join the soundboard.</p>
    <div class="grid grid--lg">
      {fresh.map((s) => (
        <SoundButton slug={s.id} title={s.data.title} audio={s.data.audio} duration={s.data.duration} category={s.data.category} isNew />
      ))}
    </div>
  </section>

  {rest.length > 0 && (
    <section class="section">
      <div class="section-head">
        <h2>Everything else, newest first</h2>
      </div>
      <p class="section-sub">The full back catalogue in the order it was added.</p>
      <div class="grid">
        {rest.map((s) => (
          <SoundButton slug={s.id} title={s.data.title} audio={s.data.audio} duration={s.data.duration} category={s.data.category} />
        ))}
      </div>
    </section>
  )}
</Base>
