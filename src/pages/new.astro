---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SoundButton from '../components/SoundButton.astro';

const sounds = (await getCollection('sounds')).sort(
  (a, b) => b.data.added.valueOf() - a.data.added.valueOf()
);
const fresh = sounds.slice(0, 18);
const rest = sounds.slice(18);
const latest = sounds[0]?.data.added;
const latestLabel = latest
  ? latest.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : '';
---
<Base
  title="New Sound Buttons — Latest Meme Sounds | Bleepboard"
  description="The newest sound buttons on Bleepboard. Fresh meme sounds and viral audio clips added every week — play and download free."
>
  <section class="page-head">
    <p class="eyebrow"><span class="tick"></span>Freshest first</p>
    <h1>New sounds</h1>
    <p class="lede">
      The latest sound buttons on the board. We cut new memes within days of them
      taking off, so this is where a trend lands first.
    </p>
    <ul class="stats">
      <li><b class="tnum">{sounds.length}</b> sounds on the board</li>
      {latestLabel && <li>Last update <b>{latestLabel}</b></li>}
      <li><b>New</b> memes every week</li>
    </ul>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Just added</h2>
      <a class="section-link" href="/trending/">What's trending →</a>
    </div>
    <p class="section-sub">The most recent {fresh.length} clips to join the soundboard.</p>
    <div class="grid grid--lg">
      {fresh.map((s) => (
        <SoundButton slug={s.id} title={s.data.title} audio={s.data.audio} duration={s.data.duration} isNew />
      ))}
    </div>
  </section>

  {rest.length > 0 && (
    <section class="section">
      <div class="section-head">
        <h2>Everything else, newest first</h2>
      </div>
      <p class="section-sub">The full back catalogue in the order it was added.</p>
      <div class="grid">
        {rest.map((s) => (
          <SoundButton slug={s.id} title={s.data.title} audio={s.data.audio} duration={s.data.duration} />
        ))}
      </div>
    </section>
  )}
</Base>
