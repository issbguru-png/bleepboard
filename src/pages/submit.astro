---
/**
 * /submit/ — send a sound in.
 *
 * Two states, decided by SUBMIT_ENDPOINT_LIVE in src/lib/submissions.ts:
 * the upload form once the Cloudflare Function is reachable, and an email
 * route until then. It never renders a form that posts nowhere.
 *
 * The rules block is not boilerplate. Submissions are how a soundboard picks
 * up material nobody checked, and this site's audience is school-age, so the
 * page states what will be refused before anybody spends time on a clip.
 */
import Base from '../layouts/Base.astro';
import { SITE, pickTitle, buildDescription } from '../lib/site';
import { breadcrumbs } from '../lib/schema';
import {
  SUBMIT_ENDPOINT_LIVE,
  SUBMIT_EMAIL_LIVE,
  TURNSTILE_SITE_KEY,
  SUBMIT_EMAIL,
  MAX_MB,
  ACCEPTED,
} from '../lib/submissions';

const pageUrl = SITE.url + '/submit/';
const formLive = SUBMIT_ENDPOINT_LIVE && TURNSTILE_SITE_KEY !== '';

const title = pickTitle([
  'Submit a Sound: Add Your Clip to Bleepboard',
  'Submit a Sound to Bleepboard',
  'Submit a Sound',
]);
const description = buildDescription([
  'Send us a sound for the board.',
  `${ACCEPTED.join(', ')} up to ${MAX_MB} MB, credited to you by name.`,
  'Every submission is reviewed by a person before it goes live.',
]);

const mailBody = [
  'Sound name:',
  '',
  'Where it comes from (if you made it, say so):',
  '',
  'Name to credit you as:',
  '',
  'I confirm I have the right to share this clip: yes / no',
  '',
  '(Attach the audio file to this email.)',
  '',
].join('\n');
const mailHref = `mailto:${SUBMIT_EMAIL}?subject=${encodeURIComponent('Sound submission')}&body=${encodeURIComponent(mailBody)}`;

const schema = [
  breadcrumbs([
    ['Home', SITE.url + '/'],
    ['Submit a Sound', pageUrl],
  ]),
];
---
<Base title={title} description={description} schema={schema}>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span class="sep" aria-hidden="true">›</span>
    <span class="here">Submit a Sound</span>
  </nav>

  <section class="hub-hero">
    <p class="eyebrow"><span class="tick"></span>Contribute</p>
    <h1>Submit a Sound</h1>
    <p class="lede">
      Most of what is on this board was put here by us. This is how that changes.
      Send a clip, tell us where it came from, and if it passes review it goes up
      with your name on it.
    </p>
  </section>

  <section class="section prose">
    <h2>What Gets Accepted</h2>
    <p>
      Short clips that someone would actually press a button for. Under about
      fifteen seconds is the sweet spot, {ACCEPTED.join(', ')} format, up to {MAX_MB} MB.
      Clean audio beats a famous clip recorded off a phone speaker.
    </p>
    <p>
      You need the right to share it. That means you made it, or it is genuinely
      yours to give away. A clip ripped from a film, a game, a TV show or a
      record is not, however widely it circulates, and those are refused however
      good they are.
    </p>

    <h2>What Gets Refused</h2>
    <ul class="rules">
      <li><b>Music and media you do not own.</b> Songs, film and TV audio, game rips, anything under a label or a studio.</li>
      <li><b>Slurs and harassment.</b> Including clips whose only purpose is to be shouted at someone.</li>
      <li><b>Sexual or crude-sexual audio</b>, drug references, and politically charged clips.</li>
      <li><b>Real people's voices without their say-so.</b> A private recording of someone is not yours to publish.</li>
      <li><b>Anything recorded off a call or a classroom</b> where the people in it did not know.</li>
    </ul>
    <p>
      A person listens to every submission against that list before anything
      appears. Nothing is published automatically, so expect days rather than
      minutes, and expect a refusal to come without a long explanation.
    </p>

    {formLive ? (
      <>
        <h2>Send It</h2>
        <form class="submit-form" method="post" action="/api/submit" enctype="multipart/form-data">
          <p class="field">
            <label for="f-title">Sound name</label>
            <input id="f-title" name="title" type="text" required maxlength="60" placeholder="Dog sneeze" />
          </p>
          <p class="field">
            <label for="f-audio">Audio file</label>
            <input id="f-audio" name="audio" type="file" required accept="audio/mpeg,audio/wav,audio/ogg,.mp3,.wav,.ogg" />
            <span class="hint">{ACCEPTED.join(', ')}, up to {MAX_MB} MB.</span>
          </p>
          <p class="field">
            <label for="f-source">Where does it come from?</label>
            <textarea id="f-source" name="source" required maxlength="400" rows="3"
              placeholder="I recorded my dog in 2024."></textarea>
            <span class="hint">"I made it" is a complete answer. Vagueness here is the usual reason a clip is refused.</span>
          </p>
          <p class="field">
            <label for="f-name">Name to credit you as</label>
            <input id="f-name" name="name" type="text" required maxlength="40" placeholder="Anonymous is fine" />
          </p>
          <p class="field">
            <label for="f-contact">Email, if you want to hear back</label>
            <input id="f-contact" name="contact" type="email" maxlength="120" placeholder="Optional" />
            <span class="hint">Only used to answer you about this clip.</span>
          </p>
          <p class="field check">
            <label>
              <input type="checkbox" name="rights" required />
              I have the right to share this clip, and I have read what gets refused.
            </label>
          </p>
          <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY}></div>
          <p class="btn-row">
            <button class="btn primary" type="submit">Send for review</button>
          </p>
          <p class="form-note" data-submit-status role="status" aria-live="polite"></p>
        </form>
        <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
        <script src="../scripts/submit-form.ts"></script>
      </>
    ) : (
      <>
        <h2>Send It</h2>
        {SUBMIT_EMAIL_LIVE ? (
          <>
            <p>
              The upload form is not open yet. It needs a server behind it and
              this site is still served as static files, so rather than show you
              a form that quietly loses your clip, here is the route that works
              today.
            </p>
            <p class="btn-row">
              <a class="btn primary" href={mailHref}>Email your sound in</a>
            </p>
            <p>
              That opens a message to <b>{SUBMIT_EMAIL}</b> with the questions
              already filled in. Attach the audio and send. Same review, same
              credit, same rules as above.
            </p>
          </>
        ) : (
          <>
            <p>
              Submissions are not open yet. The upload form needs a server
              behind it and the mailbox is not running either, so there is
              currently no route that would actually reach us. Rather than take
              a clip you spent time on and drop it, here is the honest state of
              it.
            </p>
            <p>
              The rules above are the ones that will apply when it opens, so
              they are worth reading now if you have something in mind. Check
              back shortly.
            </p>
          </>
        )}
      </>
    )}

    <h2>Credit and Takedown</h2>
    <p>
      An accepted clip gets a contributor page with your name on it, and every
      clip you send is listed there. Ask us and we will take any of it down, no
      reason needed. Rights holders can do the same through the
      <a href="/dmca/">DMCA page</a>, and we would rather hear from you directly
      than through a form.
    </p>
  </section>
</Base>

<style>
  .rules { margin: 0 0 var(--s4); padding-left: 1.1em; }
  .rules li { margin-bottom: var(--s2); line-height: 1.55; }

  .submit-form { max-width: 560px; margin: 0 0 var(--s4); }
  .field { display: block; margin: 0 0 var(--s4); }
  .field label { display: block; margin-bottom: 6px; font-weight: 700; }
  .field input[type='text'],
  .field input[type='email'],
  .field input[type='file'],
  .field textarea {
    width: 100%;
    min-height: 44px;
    padding: 10px 12px;
    border: 1px solid var(--line-2);
    border-radius: var(--r-sm);
    background: var(--surface);
    color: var(--ink);
    font: inherit;
  }
  .field textarea { min-height: 88px; resize: vertical; }
  .field input:focus-visible,
  .field textarea:focus-visible { outline: 3px solid var(--focus); outline-offset: 1px; }
  .hint { display: block; margin-top: 5px; font-size: var(--step--1); color: var(--ink-3); }
  .field.check label { display: flex; gap: 10px; align-items: flex-start; font-weight: 600; }
  .field.check input { margin-top: 3px; flex: none; }
  .cf-turnstile { margin: 0 0 var(--s3); }
  .form-note { min-height: 1.5em; margin-top: var(--s3); font-weight: 650; }
  .form-note[data-state='error'] { color: var(--accent-text); }
</style>
