---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SoundButton from '../../components/SoundButton.astro';
import { SITE, hubPath, soundPath, fmtDuration } from '../../lib/site';

export async function getStaticPaths() {
  const sounds = await getCollection('sounds');
  return sounds.map((s) => ({ params: { slug: s.id }, props: { sound: s } }));
}

const { sound } = Astro.props;
const d = sound.data;
const category = await getEntry('categories', d.category);
const catName = category?.data.name ?? d.category;

// related: same category or overlapping tags, excluding self
const all = await getCollection('sounds');
const related = all
  .filter((s) => s.id !== sound.id)
  .map((s) => ({
    s,
    score:
      (s.data.category === d.category ? 2 : 0) +
      s.data.tags.filter((t) => d.tags.includes(t)).length,
  }))
  .filter((r) => r.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 12)
  .map((r) => r.s);

const pageUrl = SITE.url + soundPath(sound.id);
const audioUrl = SITE.url + d.audio;
const title = `${d.title} Sound Button — Play & Download MP3 | ${SITE.name}`;
const description = `Play the ${d.title} sound button instantly and download the MP3 free. ${d.origin ?? ''}`.slice(0, 158);

const embedCode = `<iframe src="${SITE.url}/embed/${sound.id}/" width="220" height="90" style="border:0" loading="lazy" title="${d.title} sound button"></iframe><br><a href="${pageUrl}">${d.title} sound button on Bleepboard</a>`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'AudioObject',
    name: d.title,
    contentUrl: audioUrl,
    duration: `PT${d.duration}S`,
    encodingFormat: 'audio/mpeg',
    url: pageUrl,
    description: d.blurb.slice(0, 200),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: catName + ' Soundboard', item: SITE.url + hubPath(d.category) },
      { '@type': 'ListItem', position: 3, name: d.title, item: pageUrl },
    ],
  },
];
---
<Base title={title} description={description} schema={schema}>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a> › <a href={hubPath(d.category)}>{catName} Soundboard</a> › {d.title}
  </nav>

  <div class="sound-hero card" style="display:flex;align-items:center;gap:20px;flex-wrap:wrap">
    <button class="bleep-play" data-src={d.audio} aria-label={`Play ${d.title}`} style="width:72px;height:72px;font-size:26px">▶</button>
    <div>
      <h1 style="margin:0">{d.title}</h1>
      <p class="small" style="margin:4px 0 0">
        {catName} · {fmtDuration(d.duration)} · {d.plays.toLocaleString()} plays
      </p>
    </div>
  </div>

  <div class="btn-row">
    <a class="btn primary" href={d.audio} download={`${sound.id}.mp3`}>⬇ Download MP3</a>
    <button class="btn" data-copy={pageUrl}>Copy link</button>
    <a class="btn" href={hubPath(d.category)}>More {catName} sounds</a>
  </div>

  <section class="prose">
    <p>{d.blurb}</p>
    {d.origin && <p class="muted"><strong>Origin:</strong> {d.origin}</p>}
    {d.explainer && <p><a href={d.explainer}>Read the full story behind this sound →</a></p>}
  </section>

  <section>
    <h2>Embed this sound button</h2>
    <p class="muted">Paste this into your site, blog, or stream overlay:</p>
    <pre class="embed-code">{embedCode}</pre>
  </section>

  {d.tags.length > 0 && (
    <div class="chips">
      {d.tags.map((t) => <span class="chip">#{t}</span>)}
    </div>
  )}

  {related.length > 0 && (
    <section>
      <h2>You may also like</h2>
      <div class="grid">
        {related.map((s) => (
          <SoundButton slug={s.id} title={s.data.title} audio={s.data.audio} duration={s.data.duration} />
        ))}
      </div>
    </section>
  )}
</Base>
