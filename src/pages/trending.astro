---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SoundButton from '../components/SoundButton.astro';
import StatIcon from '../components/StatIcon.astro';
import { SITE, soundPath } from '../lib/site';
import { breadcrumbs, itemList } from '../lib/schema';

const sounds = (await getCollection('sounds')).sort(
  (a, b) => b.data.plays - a.data.plays
);
const top = sounds.slice(0, 12);
const rest = sounds.slice(12);

// The list is the full ranked set this page renders, in render order.
const schema = [
  breadcrumbs([
    ['Home', SITE.url + '/'],
    ['Trending', SITE.url + '/trending/'],
  ]),
  // Ordered by the editorial `plays` weight, which is a curation signal rather
  // than a measured play count — so the wording here claims popularity, not a
  // statistic. See the note in src/content.config.ts.
  itemList(
    'Trending sound buttons',
    sounds.map((s) => ({ name: s.data.title, url: SITE.url + soundPath(s.id) })),
    'Every sound button on Bleepboard, most popular first.'
  ),
];
---
<Base
  title={`Trending Sound Buttons — ${sounds.length} Popular Meme Sounds`}
  description="The most popular sound buttons on Bleepboard — the meme sounds people come here for, ranked. Tap to play, free MP3 downloads."
  schema={schema}
>
  <section class="page-head">
    <div class="hero-mark">
      <StatIcon name="ranked" size={48} />
      <p class="eyebrow"><span class="tick"></span>Most popular</p>
    </div>
    <h1>Trending sounds</h1>
    <p class="lede">
      The sounds people come to this board for, ranked by how big each one is
      right now. Our call, not a play counter.
    </p>
    <ul class="stats stats--icon">
      <li><StatIcon name="ranked" /><span><b class="tnum">{sounds.length}</b> sounds ranked</span></li>
      <li><StatIcon name="download" /><span><b>Free</b> MP3 downloads</span></li>
    </ul>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Top 12 right now</h2>
      <a class="section-link" href="/new/">See what's new →</a>
    </div>
    <p class="section-sub">The board's heavy hitters.</p>
    <div class="grid grid--lg">
      {top.map((s, i) => (
        <SoundButton slug={s.id} title={s.data.title} audio={s.data.audio} duration={s.data.duration} category={s.data.category} rank={i + 1} />
      ))}
    </div>
  </section>

  {rest.length > 0 && (
    <section class="section">
      <div class="section-head">
        <h2>The rest of the chart</h2>
      </div>
      <p class="section-sub">Ranks 13–{sounds.length}, still sorted by plays.</p>
      <div class="grid">
        {rest.map((s, i) => (
          <SoundButton slug={s.id} title={s.data.title} audio={s.data.audio} duration={s.data.duration} category={s.data.category} rank={i + 13} />
        ))}
      </div>
    </section>
  )}
</Base>
