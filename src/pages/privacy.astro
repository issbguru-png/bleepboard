---
import Base from '../layouts/Base.astro';

/* --- What is actually running ---------------------------------------------
   These flags are imported, never re-declared here. The page describes what
   src/lib/monetization.ts switches on, so if the page and the site ever
   disagree about whether a tag loads, the bug is in one file rather than two.

   Do not add a local copy of any of these values. That is how a privacy policy
   drifts into saying something untrue.
------------------------------------------------------------------------- */
import {
  AD_NETWORK,
  ADSENSE_ID,
  USE_GOOGLE_CMP,
  CHILD_DIRECTED,
  POLICY_EFFECTIVE,
  ADS_LIVE,
  ANALYTICS_LIVE,
  ADSENSE_LIVE,
  MEDIAVINE_LIVE,
  TRACKING_LIVE,
} from '../lib/monetization';

/* Mirrors the exact condition Analytics.astro uses to load Google Funding
   Choices, so the reopen control below can never be offered when the tool it
   calls was never loaded. */
const CMP_LIVE = TRACKING_LIVE && USE_GOOGLE_CMP && ADSENSE_ID !== '';

/* Mediavine ships a consent management platform inside its own script. */
const CONSENT_TOOL = CMP_LIVE || MEDIAVINE_LIVE;

/* An ad network can be selected while its ID is still blank. Nothing loads in
   that state, and the page has to say so rather than assume one of the two
   tidy cases. */
const AD_NETWORK_PENDING = ADS_LIVE && !ADSENSE_LIVE && !MEDIAVINE_LIVE;

/* --- Last updated ---------------------------------------------------------
   POLICY_EFFECTIVE is a fixed string in the config. Formatting it is safe;
   calling new Date() with no argument would claim a fresh revision on every
   deploy, which is a lie told by a build script.
------------------------------------------------------------------------- */
const LAST_UPDATED = new Date(`${POLICY_EFFECTIVE}T00:00:00Z`).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

/* --- Contact --------------------------------------------------------------
   dmca@bleepboard.com is the one address that demonstrably exists (it is the
   target of every Report menu on every sound page, and of /dmca/). It is used
   here as the working fallback so this page never points at a black hole.

   TODO (owner): provision `privacy@bleepboard.com` and swap PRIVACY_TO to it.
   Both AdSense and Mediavine expect a contact route on the privacy policy, and
   a shared legal/copyright inbox is workable but not ideal. Until the mailbox
   exists, do NOT print it — an address that bounces is worse than a shared one.
------------------------------------------------------------------------- */
const PRIVACY_TO = 'dmca@bleepboard.com';

/* The summary paragraph, assembled from the flags so it stays true in every
   combination rather than only the two obvious ones. Analytics can be live
   while advertising is not, an ad network can be chosen before its ID exists,
   and consent can be denied by default with no banner loaded to grant it. Each
   of those states says something different. */
const liveBits: string[] = [];
if (ANALYTICS_LIVE) liveBits.push('Google Analytics 4');
if (ADSENSE_LIVE) liveBits.push('Google AdSense');
if (MEDIAVINE_LIVE) liveBits.push('Mediavine');

const consentClause = CONSENT_TOOL
  ? ' In the EEA, the UK and Switzerland none of that storage happens until you answer the consent banner.'
  : ' In the EEA, the UK and Switzerland that storage stays switched off, because the consent it would need is not being collected yet.';

const liveSummary = liveBits.length
  ? `${liveBits.join(' and ')} ${liveBits.length > 1 ? 'now run' : 'now runs'} on these pages and ${liveBits.length > 1 ? 'store' : 'stores'} cookies or similar identifiers in your browser.` +
    (ADS_LIVE ? '' : ' No advertising code runs on the site.') +
    consentClause
  : `The site's configuration selects the ${AD_NETWORK} ad network, but its ID has not been filled in, so no advertising or analytics code is actually requested yet.`;

/* Opt-out routes. These are the controls the networks themselves point at.
   We link them; we do not operate them and cannot promise what they do. */
const optOuts = [
  {
    label: 'Google Ads Settings',
    href: 'https://myadcenter.google.com/',
    blurb:
      'Turn off personalised advertising across Google’s own products and the sites that use Google’s ad technology, including this one.',
  },
  {
    label: 'How Google uses advertising cookies',
    href: 'https://policies.google.com/technologies/ads',
    blurb:
      'Google’s own description of the cookies and identifiers it uses to serve and measure ads. Worth reading before you decide what to switch off.',
  },
  {
    label: 'aboutads.info (US)',
    href: 'https://optout.aboutads.info/',
    blurb:
      'The Digital Advertising Alliance’s page for opting out of interest-based ads from many third-party vendors at once.',
  },
  {
    label: 'YourAdChoices (Canada)',
    href: 'https://youradchoices.ca/en/tools',
    blurb:
      'The Canadian equivalent, run by the Digital Advertising Alliance of Canada.',
  },
  {
    label: 'Your Online Choices (EU/UK)',
    href: 'https://www.youronlinechoices.eu/',
    blurb:
      'The European version, run by EDAA. Same idea, a different set of participating vendors.',
  },
  {
    label: 'NAI opt-out',
    href: 'https://optout.networkadvertising.org/',
    blurb:
      'Network Advertising Initiative member opt-outs, covering another slice of the ad-tech supply chain.',
  },
];

/* The meta description has to survive the flags too. A page that promises an
   advertising section when no ad network is running is a small lie told in the
   search results rather than on the page, which is not an improvement. */
const description = (() => {
  if (ANALYTICS_LIVE && ADS_LIVE)
    return 'How Bleepboard handles data: what Google Analytics and advertising partners collect, how consent works in the EEA, UK and Switzerland, and how to opt out.';
  if (ANALYTICS_LIVE)
    return 'How Bleepboard handles data: what Google Analytics collects, how consent works in the EEA, UK and Switzerland, and your GDPR and CPRA rights. No ads run yet.';
  if (ADS_LIVE)
    return 'How Bleepboard handles data: what advertising partners collect, how consent works in the EEA, UK and Switzerland, how to opt out, and your GDPR and CPRA rights.';
  return 'How Bleepboard handles data: no accounts, no analytics, no ads today, one favourites list that stays in your browser, plus your GDPR and CPRA rights.';
})();
---
<Base title="Privacy Policy | Bleepboard" description={description}>
  <section class="page-head">
    <p class="eyebrow"><span class="tick"></span>Legal</p>
    <h1>Privacy policy</h1>
    <p class="lede">
      Bleepboard is a static website that plays short audio clips. There is no account to
      make, no login, no newsletter and no database with your name in it. This page says
      what happens to data when you use the site, including the parts that are genuinely
      nothing.
    </p>
    <p class="updated">
      Last updated <time datetime={POLICY_EFFECTIVE}>{LAST_UPDATED}</time>
    </p>
  </section>

  {/* ==================== 0. the short version ==================== */}
  <section class="section" id="summary">
    <div class="section-head">
      <h2>The short version</h2>
    </div>
    <p class="section-sub">
      The whole policy in a paragraph, for people who are here to play a sound and leave.
    </p>

    <div class="summary">
      <p class="summary-lead">
        Bleepboard holds no accounts and asks you for no personal information. The only
        thing the site itself saves on your device is your favourites list, and that never
        leaves your browser. The host that serves the pages keeps standard access logs, as
        every web host does.
      </p>
      {!TRACKING_LIVE && (
        <p class="summary-lead summary-second">
          No analytics and no advertising code runs today, so nothing on these pages sets a
          cookie. The sections below describe exactly what will run when that changes. They
          are here to be read before anything happens rather than afterwards.
        </p>
      )}
      {TRACKING_LIVE && (
        <p class="summary-lead summary-second">{liveSummary}</p>
      )}

      <div class="ledger">
        <div class="ledger-col">
          <p class="ledger-head" data-kind="yes">What is stored</p>
          <ul class="ledger-list">
            <li>Your favourites, in your browser’s local storage</li>
            <li>Standard web-server access logs, held by the host</li>
            {ANALYTICS_LIVE && (
              <li>Google Analytics cookies and usage measurements, where consent allows</li>
            )}
            {ADS_LIVE && <li>Advertising cookies and identifiers, set by ad vendors</li>}
            {CONSENT_TOOL && <li>Your consent answer, recorded by the consent tool</li>}
          </ul>
        </div>
        <div class="ledger-col">
          <p class="ledger-head" data-kind="no">What is not</p>
          <ul class="ledger-list">
            <li>No accounts, names, emails or passwords</li>
            {!TRACKING_LIVE && <li>No cookies, from us or from anyone else</li>}
            {!ANALYTICS_LIVE && <li>No analytics or visitor tracking</li>}
            {!ADS_LIVE && <li>No advertising and no ad cookies</li>}
            {ANALYTICS_LIVE && <li>No Google Signals, so no cross-device analytics profile</li>}
            <li>No personal information sold for money</li>
            {!ADS_LIVE && <li>No sharing for cross-context behavioural advertising</li>}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* ==================== 1. on your device ==================== */}
  <section class="section" id="device">
    <div class="section-head">
      <h2>What the site stores on your device</h2>
    </div>
    <p class="section-sub">
      One key, holding a list of sound names. That is the entirety of what Bleepboard
      itself keeps.
    </p>

    <dl class="facts">
      <div>
        <dt>Storage key</dt>
        <dd><code>bleepboard:favourites</code></dd>
      </div>
      <div>
        <dt>Mechanism</dt>
        <dd>Browser local storage, not a cookie, so it is never attached to a network request.</dd>
      </div>
      <div>
        <dt>Contents</dt>
        <dd>A list of the short names of the sounds you saved, most recent first. Nothing else.</dd>
      </div>
      <div>
        <dt>Where it goes</dt>
        <dd>Nowhere. It is read and written by code running in your browser and is never transmitted to us or anyone else.</dd>
      </div>
    </dl>

    <div class="prose">
      <p>
        Because it lives in your browser rather than on a server, your favourites are
        per-browser and per-device. Save something on your phone and it will not appear on
        your laptop. That is a genuine limitation, and it is the direct consequence of not
        having accounts.
      </p>
      <p>
        If your browser blocks site data, in a private window or under strict privacy
        settings, the favourite button disables itself and says so rather than accepting
        taps it cannot remember. The site also writes and immediately deletes a tiny
        throwaway value on load, purely to test whether storage works at all. It holds
        nothing and does not survive the check.
      </p>
      <p>
        <strong>To clear it:</strong> use your browser’s “clear site data”, “cookies and
        site data”, or “clear browsing data” option for bleepboard.com. In most browsers
        that setting is under Settings → Privacy. Clearing it deletes your favourites
        permanently and immediately. There is no copy anywhere else to delete, and nothing
        for us to do on our end.
      </p>
    </div>

    <p class="origin-note">
      <b>Note</b>
      <span>
        Playing a sound also asks your device for a very short vibration on phones that
        support it, and the share and copy buttons hand text to your operating system’s
        share sheet or clipboard. Those are browser features acting on your device. We
        never see what you shared, or where you sent it.
      </span>
    </p>
  </section>

  {/* ==================== 2. analytics ==================== */}
  <section class="section" id="analytics">
    <div class="section-head">
      <h2>Analytics</h2>
    </div>
    <p class="section-sub">
      Who is counting, what they count, and what they cannot see.
    </p>

    {!ANALYTICS_LIVE && (
      <p class="status">
        <b>Not active</b>
        <span>
          No measurement ID is configured, so no Google Analytics script is requested and
          no analytics cookie is set on these pages. The setup described below is already
          written into the site’s code and takes effect the moment an ID is added.
        </span>
      </p>
    )}
    {ANALYTICS_LIVE && (
      <p class="status" data-live>
        <b>Active</b>
        <span>
          Bleepboard uses Google Analytics 4, subject to your consent in the regions where
          consent is required.
        </span>
      </p>
    )}

    <div class="prose">
      {ANALYTICS_LIVE && (
        <p>
          Google Analytics 4 is how we know which pages people reach, which sounds are
          worth writing about next, and whether a change made the site better or worse. It
          is configured deliberately narrowly, as follows.
        </p>
      )}
      {!ANALYTICS_LIVE && (
        <p>
          Google Analytics 4 is the intended measurement tool. It would tell us which pages
          people reach and which sounds are worth writing about next. The configuration is
          already written and deliberately narrow, and this is what it will do.
        </p>
      )}

      <ul>
        <li>
          <strong>What it records:</strong> the pages you view and when, the referring site
          or search engine that sent you, and technical details about your device such as
          browser, operating system, device type, screen size and language.
        </li>
        <li>
          <strong>Approximate location:</strong> derived from your IP address, at roughly
          country, region and city level. The tag is configured with IP anonymisation
          switched on, which asks Google to shorten the address before it is used, so the
          full address is not part of the reporting.
        </li>
        <li>
          <strong>Cookies and local identifiers:</strong> Google Analytics stores a randomly
          generated identifier in first-party cookies, named <code>_ga</code> and
          <code>_ga_</code> followed by the measurement ID, so that a returning browser is
          recognised as the same browser. It is an identifier for a browser, not a name for
          a person.
        </li>
        <li>
          <strong>Google Signals is switched off.</strong> The tag sets
          <code>allow_google_signals: false</code>, so analytics data is not joined to
          signed-in Google accounts for cross-device reporting or advertising audiences. A
          soundboard does not need that, so it is not enabled.
        </li>
        <li>
          <strong>Nothing about you personally.</strong> We send no name, email address,
          account or user ID, because the site has none to send.
        </li>
        <li>
          <strong>Consent comes first where it is required.</strong> In the EEA, the UK and
          Switzerland the analytics storage permission starts denied, and no analytics
          cookie is written until you allow it.
          {ANALYTICS_LIVE && !CONSENT_TOOL && (
            <> No consent tool is loaded at the moment, so in those regions the permission
            simply stays denied.</>
          )}
          {' '}The <a href="#consent">Consent</a> section explains how that works.
        </li>
      </ul>

      <p>
        The data collected by the tag goes to Google and is handled under Google’s own
        terms and privacy policy rather than ours. Google publishes its own account of what
        it collects on sites that use its services:
        <a href="https://policies.google.com/technologies/partner-sites" rel="noopener">How
        Google uses information from sites or apps that use our services</a>. We can see
        aggregate reports in the Analytics interface. We cannot see who you are, and we
        cannot connect a report row to a person.
      </p>

      {ANALYTICS_LIVE && (
        <>
          <h3>Turning analytics off</h3>
          <p>
            Blocking cookies for this site, or running a content blocker, stops the tag
            reporting anything. Google also publishes a
            <a href="https://tools.google.com/dlpage/gaoptout" rel="noopener">Google
            Analytics opt-out browser add-on</a>, which switches the measurement off in your
            browser across every site that uses Analytics rather than only this one. Nothing
            on this site tries to detect or work around either.
          </p>
        </>
      )}

      <h3>The play counter</h3>
      <p>
        There is one loose end worth being straight about. When you play a sound, the site
        fires a single tiny same-origin request intended to count plays, so that the
        trending list could reflect what people actually play. <strong>Nothing is listening
        at the other end.</strong> The counter it was written for was never connected, so
        the request reaches the static host, finds nothing, and is discarded. It carries
        only the short name of the sound, with no identifier, no cookie and nothing about
        you, and even that is currently counted by no one.
      </p>
      {/* TODO (owner): the play-count endpoint (functions/api/play.ts) is a Cloudflare
          Pages Function, while the site deploys to GitHub Pages — so it is inert twice
          over: the function is not deployed, and its KV binding (PLAYS) was never
          provisioned. Verified against RESUME.md and .github/workflows/. If either
          changes, this subsection must change with it. */}
    </div>
  </section>

  {/* ==================== 3. advertising ==================== */}
  <section class="section" id="advertising">
    <div class="section-head">
      <h2>Advertising</h2>
    </div>
    <p class="section-sub">
      The one part of this page that describes companies other than us.
    </p>

    {!ADS_LIVE && (
      <p class="status">
        <b>Not active</b>
        <span>
          No ad network is switched on, so no advertising script is requested, no ad unit is
          placed and no advertising cookie is set by this site. This section describes what
          will apply when advertising is added.
        </span>
      </p>
    )}
    {AD_NETWORK_PENDING && (
      <p class="status">
        <b>Selected, not yet loading</b>
        <span>
          The {AD_NETWORK} network is selected in the site’s configuration, but its ID has
          not been filled in, so no ad code is requested yet. This section describes what
          will apply once it is.
        </span>
      </p>
    )}
    {(ADSENSE_LIVE || MEDIAVINE_LIVE) && (
      <p class="status" data-live>
        <b>Active</b>
        <span>
          Bleepboard carries advertising supplied by third-party ad technology. The
          following describes how that works and how to opt out.
        </span>
      </p>
    )}

    <div class="prose">
      <p>
        Bleepboard is free, and
        {ADS_LIVE
          ? ' the way it stays free is advertising'
          : ' the plan for keeping it free is advertising'} rather than paywalls or data
        sales. Advertising brings other companies into the picture, and their behaviour is
        not something we can promise on their behalf. What follows is true of ad technology
        generally, and
        {ADS_LIVE
          ? ' of the setup running here.'
          : ' will be true here once advertising is switched on.'}
      </p>
      <ul>
        <li>
          <strong>Third-party vendors, including Google, use cookies and similar
          identifiers</strong> to serve and measure ads, including ads based on your prior
          visits to this website and to other websites.
        </li>
        <li>
          <strong>Ad exchanges and demand partners sit behind the slot itself.</strong> A
          single ad placement can involve many companies bidding in real time, each of which
          may set or read its own identifier. That chain is operated by the ad network, not
          by us.
        </li>
        <li>
          <strong>We never receive the identifiers.</strong> Advertising cookies are set by
          those companies under their own privacy policies. We cannot read them, we cannot
          delete them for you, and the opt-out routes below go directly to the parties that
          can.
        </li>
        <li>
          <strong>You can opt out of personalised advertising</strong> through Google Ads
          Settings and the industry pages listed below, and through your browser’s own
          cookie controls.
        </li>
      </ul>

      {ADSENSE_LIVE && (
        <>
          <h3>Google AdSense</h3>
          <p>
            Ads here are served by Google AdSense. Google’s use of advertising cookies
            enables it and its partners to serve ads based on your visits to Bleepboard and
            other sites on the internet. You can turn off personalised advertising in
            <a href="https://myadcenter.google.com/" rel="noopener">Google Ads Settings</a>,
            and Google explains its own ad technology on its
            <a href="https://policies.google.com/technologies/ads" rel="noopener">advertising
            technologies page</a>. Ad units placed by hand on this site reserve their space
            before anything loads, so an ad arriving does not push the page around
            underneath you.
          </p>
        </>
      )}
      {MEDIAVINE_LIVE && (
        <>
          <h3>Mediavine</h3>
          <p>
            Ads here are managed by Mediavine, which places and fills the slots through its
            own script. Mediavine works with a long list of advertising partners and
            exchanges, and each of those may set or read its own cookies and identifiers
            when an ad is requested or measured. Mediavine publishes its own privacy policy
            and the current partner list on
            <a href="https://www.mediavine.com/" rel="noopener">mediavine.com</a>, and its
            consent tool is described under <a href="#consent">Consent</a> below.
          </p>
        </>
      )}
      {!ADSENSE_LIVE && !MEDIAVINE_LIVE && (
        <>
          <h3>Which network</h3>
          <p>
            The two routes being considered are Google AdSense, which is self-managed, and
            Mediavine, which is a managed provider that fills the slots through its own
            script and a long list of advertising partners. The site’s code supports either
            one, and ships neither until a network and an ID are configured. When that
            happens, this section will name the network that is actually running and this
            paragraph will go.
          </p>
        </>
      )}

      {CHILD_DIRECTED && (
        <p>
          Because the site is tagged for child-directed treatment, ad requests carry that
          flag and ad units are marked with it. In practice that means non-personalised ads
          only. The <a href="#children">Children</a> section covers this.
        </p>
      )}
    </div>

    <div class="opt-grid" id="opt-outs">
      {optOuts.map((o) => (
        <a class="opt-card" href={o.href} rel="noopener">
          <b>{o.label}</b>
          <span class="opt-blurb">{o.blurb}</span>
          <span class="opt-host">{new URL(o.href).host}</span>
        </a>
      ))}
    </div>

    <div class="prose">
      <h3>Browser-level controls</h3>
      <p>
        Every major browser lets you block or delete third-party cookies, and several block
        cross-site tracking by default. Those settings sit under Privacy in your browser’s
        preferences and apply everywhere, not just here. Browser extensions and content
        blockers go further and can stop advertising and analytics scripts from loading at
        all. Nothing on this site tries to detect or work around any of that.
      </p>
    </div>

    <p class="origin-note">
      <b>Note</b>
      <span>
        Industry opt-outs are themselves stored by your browser, which means clearing your
        site data can clear the opt-out along with everything else, and an opt-out set in
        one browser does not carry to another. That is how the industry built it, not a
        choice made here.
      </span>
    </p>
  </section>

  {/* ==================== 4. consent ==================== */}
  <section class="section" id="consent">
    <div class="section-head">
      <h2>Consent</h2>
    </div>
    <p class="section-sub">
      What is switched off by default, where, and how to change your answer later.
    </p>

    <div class="prose">
      {!TRACKING_LIVE && (
        <p>
          Nothing that needs consent loads on the site today, so no consent defaults are
          sent and no banner appears. The mechanism below is written and waiting, and it
          takes effect in the same build that switches analytics or advertising on.
        </p>
      )}

      <p>
        Google’s tags support a consent framework called Consent Mode v2, which tells them
        what they are allowed to store before they load rather than after.
        {TRACKING_LIVE
          ? ' Bleepboard sends those defaults from the page head, ahead of any Google script, using four permissions:'
          : ' When a tag is switched on here, the defaults will be sent from the page head ahead of it, using four permissions:'}
        {' '}advertising storage, advertising user data, advertising personalisation and
        analytics storage.
      </p>
      <ul>
        <li>
          <strong>In the EEA, the UK and Switzerland, all four default to denied.</strong>
          That covers the 27 EU member states plus Iceland, Liechtenstein, Norway, the
          United Kingdom and Switzerland.
          {CONSENT_TOOL
            ? ' Nothing is stored and no identifier is set until the consent banner has been answered.'
            : ' Nothing is stored and no identifier is set until consent is granted, and no consent tool is currently loaded to collect it, so it stays denied.'}
          {' '}The tags wait briefly for an answer before carrying on.
        </li>
        <li>
          <strong>Everywhere else the four default to granted</strong>, which is the usual
          posture outside those regions. If you are in one of those places and would rather
          not be measured, your browser’s own controls and a content blocker will stop the
          tags loading, and the routes listed above cover ad personalisation.
        </li>
        <li>
          <strong>Which default applies to you is decided by Google’s tag</strong> from your
          request, not by us. We do not run geolocation of our own, and we never see the
          result.
        </li>
      </ul>

      {CMP_LIVE && (
        <>
          <h3>The consent banner</h3>
          <p>
            Consent is collected by Google Funding Choices, Google’s own certified consent
            management platform. It presents the banner, records your answer in your browser
            and passes it to the tags. Your answer is stored locally, so it is per-browser
            and per-device.
          </p>
          <p>
            To change it later, use the
            <a href="#do-not-sell">privacy controls</a> below, which reopen the same banner.
            Clearing cookies and site data for bleepboard.com also erases the stored answer,
            and the banner will ask again on your next visit.
          </p>
        </>
      )}
      {MEDIAVINE_LIVE && (
        <>
          <h3>The consent banner</h3>
          <p>
            Mediavine ships its own consent management platform as part of its script. It
            presents the banner, records your answer in your browser and passes it to the ad
            partners. Your answer is stored locally, so it is per-browser and per-device.
            Clearing cookies and site data for bleepboard.com erases it, and the banner will
            ask again on your next visit.
          </p>
          {/* TODO (owner): link the exact Mediavine privacy-policy and partner-list URLs
              here once the account exists, rather than the site root. Deep links are not
              guessed on a legal page.

              TODO (owner): Mediavine exposes a "manage privacy settings" control through
              its own script. Name the exact control here, and wire it into the
              #do-not-sell section below, once the script is live and the control has been
              confirmed in the Mediavine dashboard. Do not describe an API that has not
              been verified against a running page. */}
        </>
      )}
