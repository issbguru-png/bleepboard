    {CMP_LIVE && (
      <script is:inline>
        /* Reopens the Google Funding Choices consent message. The API is feature-
           detected rather than assumed: a script blocker, a slow network, or a
           message that was never created in the AdSense UI all leave googlefc
           undefined. In that case the button says so rather than pretending to
           have opted anyone out. is:inline keeps it here, next to the button it
           belongs to, and keeps it out of the bundle on every other page. */
        (function () {
          var btn = document.getElementById('cmp-reopen');
          var note = document.getElementById('cmp-reopen-note');
          if (!btn) return;
          btn.addEventListener('click', function () {
            var fc = window.googlefc;
            if (fc && typeof fc.showRevocationMessage === 'function') {
              fc.showRevocationMessage();
              return;
            }
            if (note) {
