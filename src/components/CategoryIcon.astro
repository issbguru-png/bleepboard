---
/**
 * CategoryIcon — one hand-authored inline SVG glyph per category hub.
 *
 * Visual system: 24×24 viewBox, stroke-only, stroke-width 2, round caps/joins,
 * fill:none, stroke:currentColor. The colour is taken from the `--cat` custom
 * property that `[data-cat]` binds on the card, so the glyph always matches the
 * board's hue and its coloured rail.
 *
 * Purely decorative — every card already carries a visible text label, so the
 * root svg is aria-hidden and must never be announced.
 *
 * All glyphs are generic, evocative shapes. No company logo, trademark or
 * copyrighted character is reproduced.
 */
interface Props {
  /** category slug, e.g. "brainrot" */
  cat: string;
  /** rendered box in px (default 24) */
  size?: number;
}
const { cat, size = 24 } = Astro.props;

const GLYPHS: Record<string, string> = {
  /* grinning face — the reaction-clip board */
  meme:
    '<circle cx="12" cy="12" r="9"/>' +
    '<path d="M8 14.2s1.4 2.3 4 2.3 4-2.3 4-2.3"/>' +
    '<path d="M9 9.5h.01"/><path d="M15 9.5h.01"/>',

  /* waveform — clean, usable audio */
  'sound-effects':
    '<path d="M3 10.5v3"/><path d="M7.5 6.5v11"/><path d="M12 3.5v17"/>' +
    '<path d="M16.5 8v8"/><path d="M21 11v2"/>',

  /* game controller */
  gaming:
    '<rect x="2" y="7" width="20" height="11" rx="4.5"/>' +
    '<path d="M7 11v3.5"/><path d="M5.25 12.75h3.5"/>' +
    '<path d="M15.9 11.5h.01"/><path d="M18.4 14h.01"/>',

  /* beamed musical note — short-form audio */
  tiktok:
    '<circle cx="6" cy="18" r="3"/><circle cx="17" cy="16" r="3"/>' +
    '<path d="M9 18V6l11-2v12"/>',

  /* bell */
  notification:
    '<path d="M18 8.5a6 6 0 0 0-12 0c0 6.5-3 8.5-3 8.5h18s-3-2-3-8.5"/>' +
    '<path d="M10.2 20.5a2 2 0 0 0 3.6 0"/>',

  /* bomb with a lit fuse */
  prank:
    '<circle cx="9.5" cy="14.5" r="7.5"/>' +
    '<path d="M14 8.5 16.4 6.1 19.4 9.1 17 11.5"/>' +
    '<path d="M17.4 5.1c-.2-2 1-3.4 3-3.5"/>',

  /* lightning bolt — the sting that escaped the show */
  anime: '<path d="M13 2 5 13.5h5.5L10 22l9-11.5h-5.5z"/>',

  /* bubbles rising underwater */
  spongebob:
    '<circle cx="9" cy="14.5" r="5.5"/>' +
    '<circle cx="17.5" cy="7" r="3"/>' +
    '<circle cx="18.5" cy="16.5" r="2"/>' +
    '<path d="M6.6 12.9a3.3 3.3 0 0 1 2.2-1.9"/>',

  /* generic voice-chat bubble (not any company mark) */
  discord:
    '<path d="M21 6.5v8a2.5 2.5 0 0 1-2.5 2.5H12l-4.5 3.5V17H5.5A2.5 2.5 0 0 1 3 14.5v-8A2.5 2.5 0 0 1 5.5 4h13A2.5 2.5 0 0 1 21 6.5z"/>' +
    '<path d="M8.5 9v3"/><path d="M12 7.5v6"/><path d="M15.5 9v3"/>',

  /* spiral — meme velocity outrunning meaning */
  brainrot:
    '<path d="M12 3a9 9 0 0 1 0 18 7 7 0 0 1 0-14 5 5 0 0 1 0 10 3 3 0 0 1 0-6 1.5 1.5 0 0 1 0 3"/>',

  /* paw print */
  animal:
    '<ellipse cx="5.2" cy="10.4" rx="1.9" ry="2.4"/>' +
    '<ellipse cx="9.9" cy="7" rx="1.9" ry="2.6"/>' +
    '<ellipse cx="14.5" cy="7" rx="1.9" ry="2.6"/>' +
    '<ellipse cx="19.2" cy="10.4" rx="1.9" ry="2.4"/>' +
    '<path d="M12.2 13.4c-2.2 0-4.1 1.9-4.1 4.2 0 1.9 1.3 3.2 3 3.2.5 0 .8-.1 1.1-.1s.6.1 1.1.1c1.7 0 3-1.3 3-3.2 0-2.3-1.9-4.2-4.1-4.2z"/>',
};

/* fallback: a neutral speaker — should never be hit for the 11 known hubs */
const inner =
  GLYPHS[cat] ??
  '<path d="M11 5 6 9H3v6h3l5 4z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/>';
---
<svg
  class="cat-ico"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
><Fragment set:html={inner} /></svg>

<style>
  .cat-ico {
    display: block;
    flex: none;
    color: var(--cat);
    margin-bottom: 5px;
    /* keeps the glyph legible over the card's tinted corner blob */
    filter: drop-shadow(0 1px 0 color-mix(in srgb, var(--surface) 60%, transparent));
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.cat-card) .cat-ico {
      transition: transform 0.25s cubic-bezier(0.2, 0.7, 0.3, 1);
    }
    :global(.cat-card:hover) .cat-ico {
      transform: translateY(-2px) scale(1.06);
    }
  }
</style>
