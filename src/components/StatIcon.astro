---
/**
 * StatIcon — one hand-authored inline SVG glyph per *stat*, the small facts
 * that sit in a `.stats` strip under a page head ("523 sound buttons",
 * "Free MP3 downloads", "Instant — no signup", …).
 *
 * Same visual system as CategoryIcon, deliberately: 24×24 viewBox, stroke-only,
 * stroke-width 2, round caps/joins, fill:none, stroke:currentColor. Colour comes
 * from `--cat`, which is `--accent` everywhere except the category hubs, where
 * `<body data-cat>` swaps in that board's hue — so the stat strip matches the
 * page the same way the old dots did.
 *
 * Purely decorative. Every stat already carries its own words, so the root svg
 * is aria-hidden and must never be announced.
 *
 * Naming is semantic, not visual, so a glyph means the same thing on every page:
 *   buttons    speaker with waves — a count of sound buttons
 *   download   arrow into a tray  — free MP3 downloads
 *   new        sparkle            — freshness / newest
 *   instant    stopwatch          — speed, no waiting, no signup
 *   plays      bar chart          — a counted play total
 *   ranked     trophy             — an ordered chart
 *   categories 2×2 grid           — a count of boards
 *   updated    calendar           — a date something last changed
 *
 * The stopwatch is drawn rather than reusing the `anime` bolt on purpose: that
 * bolt already means "anime" on every category card, and must not pick up a
 * second meaning here.
 *
 * All glyphs are generic shapes. No logo, trademark or character is reproduced.
 */
interface Props {
  /** semantic glyph name, e.g. "download" */
  name: string;
  /** rendered box in px (default 17, the stat-strip optical size) */
  size?: number;
}
const { name, size = 17 } = Astro.props;

const GLYPHS: Record<string, string> = {
  /* speaker with two waves — a count of sound buttons */
  buttons:
    '<path d="M11 5 6 9H3v6h3l5 4z"/>' +
    '<path d="M15.5 8.5a5 5 0 0 1 0 7"/>' +
    '<path d="M18.5 5.5a9 9 0 0 1 0 13"/>',

  /* arrow dropping into a tray — the free MP3 download */
  download:
    '<path d="M12 3v12"/>' +
    '<path d="m7.5 10.5 4.5 4.5 4.5-4.5"/>' +
    '<path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/>',

  /* sparkle — new, fresh, recently added */
  new:
    '<path d="m12 3 1.9 5.6L19.5 10l-5.6 1.9L12 17.5l-1.9-5.6L4.5 10l5.6-1.4z"/>' +
    '<path d="M18 16.5l.7 2.1 2.1.7-2.1.7-.7 2.1-.7-2.1-2.1-.7 2.1-.7z"/>',

  /* stopwatch — instant, no waiting (deliberately not the anime bolt) */
  instant:
    '<path d="M9.5 2.5h5"/>' +
    '<path d="M12 2.5v2.2"/>' +
    '<circle cx="12" cy="13.5" r="8"/>' +
    '<path d="M12 13.5V9.6"/>',

  /* bar chart — a counted total */
  plays:
    '<path d="M4 20.5h16"/>' +
    '<path d="M7 20.5v-4.5"/>' +
    '<path d="M12 20.5v-9"/>' +
    '<path d="M17 20.5v-13"/>',

  /* trophy — an ordered chart, ranked by plays */
  ranked:
    '<path d="M7.5 3h9v5.5a4.5 4.5 0 0 1-9 0z"/>' +
    '<path d="M7.5 5.2H5v1a3.2 3.2 0 0 0 2.9 3.2"/>' +
    '<path d="M16.5 5.2H19v1a3.2 3.2 0 0 1-2.9 3.2"/>' +
    '<path d="M12 13v7.5"/>' +
    '<path d="M8.5 20.5h7"/>',

  /* 2×2 grid — a count of boards */
  categories:
    '<rect x="3" y="3" width="7.5" height="7.5" rx="2"/>' +
    '<rect x="13.5" y="3" width="7.5" height="7.5" rx="2"/>' +
    '<rect x="3" y="13.5" width="7.5" height="7.5" rx="2"/>' +
    '<rect x="13.5" y="13.5" width="7.5" height="7.5" rx="2"/>',

  /* calendar with a marked day — when something last changed */
  updated:
    '<rect x="3" y="5" width="18" height="16" rx="3"/>' +
    '<path d="M8 2.6v4"/><path d="M16 2.6v4"/>' +
    '<path d="M3 10h18"/>' +
    '<path d="M12 15.5h.01"/>',
};

/* fallback: the speaker, the most neutral thing this site can say */
const inner = GLYPHS[name] ?? GLYPHS.buttons;
---
<svg
  class="stat-ico"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
><Fragment set:html={inner} /></svg>

<style>
  .stat-ico {
    display: block;
    flex: none;
    color: var(--cat);
  }
</style>
